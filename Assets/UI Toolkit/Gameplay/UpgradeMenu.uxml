<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenu/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=9434c721f0704004792517c2e6542b2c&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; align-items: center; background-color: rgb(38, 38, 38);">
        <ui:VisualElement name="Row-Header" class="row-header row" style="flex-grow: 3; flex-basis: 0; flex-shrink: 0; margin-top: 120px;">
            <ui:Label text="Level Up!" name="Header" class="header" style="color: rgb(255, 204, 0); font-size: 279px; -unity-text-align: middle-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Row-Cards" style="flex-grow: 9; flex-direction: column; flex-basis: 0; flex-shrink: 0; width: 50%; align-items: stretch; justify-content: flex-start; margin-bottom: 120px;">
            <ui:Button text="&#10;" name="Upgrade0" class="button" style="flex-direction: row; height: auto; align-items: center; flex-grow: 1; background-color: rgb(123, 123, 123);">
                <ui:VisualElement name="IconContainer" style="width: 100%; height: 100%; color: rgb(0, 0, 0); flex-grow: 3; flex-basis: 0; flex-shrink: 0; background-color: rgba(0, 0, 0, 0); align-items: center;">
                    <ui:VisualElement name="Icon0" style="width: 100%; height: 100%; color: rgb(0, 0, 0); flex-grow: 3; flex-basis: 0; flex-shrink: 0; background-color: rgba(0, 0, 0, 0);"/>
                </ui:VisualElement>
                <ui:VisualElement name="Text0" style="flex-grow: 9; flex-direction: column; flex-basis: 0; flex-shrink: 0; align-items: flex-start; padding-left: 80px;">
                    <ui:Label text="Label" name="Description0"/>
                    <ui:Label text="Label" name="Comparison0" style="color: rgb(255, 0, 0);"/>
                </ui:VisualElement>
            </ui:Button>
            <ui:Button text="" name="Upgrade1" class="button" style="flex-direction: row; height: auto; align-items: center; flex-grow: 1; background-color: rgb(123, 123, 123);">
                <ui:VisualElement name="IconContainer" style="flex-grow: 3; background-color: rgba(55, 55, 55, 0); width: 100%; height: 100%; flex-shrink: 0; flex-basis: 0; align-items: center;">
                    <ui:VisualElement name="Icon1" style="flex-grow: 3; background-color: rgba(55, 55, 55, 0); width: 100%; height: 100%; flex-shrink: 0; flex-basis: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Text1" style="flex-grow: 9; flex-direction: column; flex-basis: 0; flex-shrink: 0; align-items: flex-start; padding-left: 80px;">
                    <ui:Label text="Label" name="Description1"/>
                    <ui:Label text="Label" name="Comparison1" style="color: rgb(255, 0, 0);"/>
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
